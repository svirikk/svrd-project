# Скопіюй цей файл у .env і заповни реальними значеннями.
# .env НЕ повинен потрапляти у git (див. .gitignore).

PORT=3000

# Отримати токен: @BotFather в Telegram -> /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чату/каналу, куди бот надсилатиме замовлення.
# Простий спосіб дізнатись: написати боту @userinfobot або @getidsbot.
TELEGRAM_CHAT_ID=your_chat_or_channel_id_here

# Зазвичай не потрібно змінювати — лишається для Docker-образів,
# де python може бути доступний під іншим ім'ям.
PYTHON_BIN=python3
